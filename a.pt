errs = np.array(errs)
print(f'frames      : {len(errs)}')
print(f'mean rot err: {errs.mean():.3f} deg')
print(f'median      : {np.median(errs):.3f} deg')
print(f'p90         : {np.percentile(errs,90):.3f} deg')
print(f'max         : {errs.max():.3f} deg')
"

